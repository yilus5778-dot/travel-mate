# DeepSeek 文本模型 API Key(服务端,用于行程规划/意图识别)
DEEPSEEK_API_KEY=
# DeepSeek 接口地址,默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型名,默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM API Key(服务端,用于图片识别等多模态能力)
ZHIPU_API_KEY=
# 智谱接口地址,默认 https://open.bigmodel.cn/api/paas/v4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 智谱视觉模型名,默认 glm-4v-flash
ZHIPU_VL_MODEL=glm-4v-flash

# 高德「Web服务」类型 Key(服务端,用于 /api/weather 天气查询)
AMAP_WEB_SERVICE_KEY=

# 高德「Web端(JS API)」类型 Key(前端,用于行程地图展示)
VITE_AMAP_JS_KEY=
# 高德 JS API 安全密钥(前端,与上面的 Key 配对)
VITE_AMAP_JS_SECURITY_CODE=

# 协同功能 SQLite 数据库文件路径,默认 ./data/collaboration.sqlite
COLLAB_DB_PATH=./data/collaboration.sqlite
